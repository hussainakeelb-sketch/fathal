{"id":"proverbs","v":1790837693821,"questions":[{"id":"proverbs-4771687a","p":200,"t":"text","q":"كمّل المثل: \"الجار قبل ...\"","a":"الدار"},{"id":"proverbs-7cfba9ed","p":200,"t":"text","q":"كمّل المثل: \"اللي ما يعرف الصگر ...\"","a":"يشويه"},{"id":"proverbs-52d38cb6","p":200,"t":"text","q":"كمّل المثل: \"الباب اللي تجيك منه الريح ...\"","a":"سدّه واستريح"},{"id":"proverbs-ce7be38c","p":200,"t":"text","q":"كمّل المثل: \"اللي إيده بالماي ...\"","a":"مو مثل اللي إيده بالنار"},{"id":"proverbs-3906dbd8","p":200,"t":"text","q":"كمّل المثل: \"إذا صاحبك عسل ...\"","a":"لا تلحسه كله"},{"id":"proverbs-e4b63db7","p":200,"t":"text","q":"كمّل المثل: \"يوم عسل ويوم ...\"","a":"بصل"},{"id":"proverbs-4cb666f7","p":200,"t":"text","q":"كمّل المثل: \"الجمل ما يشوف ...\"","a":"حدبته"},{"id":"proverbs-3f48b3c2","p":200,"t":"text","q":"كمّل المثل: \"إجه يكحّلها ...\"","a":"عماها"},{"id":"proverbs-d1519292","p":200,"t":"text","q":"كمّل المثل: \"الگرد بعين أمه ...\"","a":"غزال"},{"id":"proverbs-e29dc7e5","p":200,"t":"text","q":"كمّل المثل: \"مو كل مرة تسلم ...\"","a":"الجرة"},{"id":"proverbs-92df4e27","p":200,"t":"text","q":"كمّل المثل: \"اللي ما يطول العنب ...\"","a":"يگول حامض"},{"id":"proverbs-a8dd5037","p":200,"t":"text","q":"كمّل المثل: \"عصفور باليد ...\"","a":"ولا عشرة على الشجرة"},{"id":"proverbs-d211ea76","p":200,"t":"text","q":"كمّل المثل: \"الشمس ما تتغطى ...\"","a":"بغربال"},{"id":"proverbs-9a1f954b","p":200,"t":"text","q":"كمّل المثل: \"العين ما تعلى على ...\"","a":"الحاجب"},{"id":"proverbs-8e3daeda","p":200,"t":"text","q":"كمّل المثل: \"اللي بالجدر ...\"","a":"يطلّعه الچمچة"},{"id":"proverbs-fb60f6a9","p":200,"t":"text","q":"كمّل المثل: \"أول الرقص ...\"","a":"حنجلة"},{"id":"proverbs-5a0f6034","p":200,"t":"text","q":"كمّل المثل: \"ضربني وبچى، ...\"","a":"سبقني واشتكى"},{"id":"proverbs-6c454c58","p":200,"t":"text","q":"كمّل المثل: \"مثل الأطرش ...\"","a":"بالزفة"},{"id":"proverbs-4cfdd166","p":200,"t":"text","q":"كمّل المثل: \"اللي فات ...\"","a":"مات"},{"id":"proverbs-d6420c02","p":200,"t":"text","q":"كمّل المثل: \"ماكو دخان ...\"","a":"بلا نار"},{"id":"proverbs-695c4b55","p":400,"t":"text","q":"كمّل المثل: \"على حس الطبل ...\"","a":"خفّن يا رجليّه"},{"id":"proverbs-fe0490b5","p":400,"t":"text","q":"كمّل المثل: \"عرب وين ...\"","a":"طنبورة وين"},{"id":"proverbs-1aa26100","p":400,"t":"text","q":"كمّل المثل: \"مو كل من صخّم وجهه ...\"","a":"صار حداد"},{"id":"proverbs-d75e2a26","p":400,"t":"text","q":"كمّل المثل: \"اللي ما يرضى بجزّة ...\"","a":"يرضى بجزّة وخروف"},{"id":"proverbs-78e36b0a","p":400,"t":"text","q":"كمّل المثل: \"حب واحچي ...\"","a":"واكره واحچي"},{"id":"proverbs-2f4c2923","p":400,"t":"text","q":"كمّل المثل: \"اللي يشوف بلوة غيره ...\"","a":"تهون عليه بلوته"},{"id":"proverbs-b7df5976","p":400,"t":"text","q":"كمّل المثل: \"إذا ردت تحيّره ...\"","a":"خيّره"},{"id":"proverbs-b310c095","p":400,"t":"text","q":"كمّل المثل: \"يقتل القتيل ...\"","a":"ويمشي بجنازته"},{"id":"proverbs-beab0c80","p":400,"t":"text","q":"كمّل المثل: \"طب الجرة على ثمها ...\"","a":"تطلع البنت لأمها"},{"id":"proverbs-bde23c1d","p":400,"t":"text","q":"كمّل المثل: \"كل ديچ على مزبلته ...\"","a":"صيّاح"},{"id":"proverbs-df197131","p":400,"t":"text","q":"كمّل المثل: \"حط راسه بين الروس ...\"","a":"وگال يا گطّاع الروس"},{"id":"proverbs-59f4e8e3","p":400,"t":"text","q":"كمّل المثل: \"مثل اللي يودّي تمر لـ...\"","a":"البصرة"},{"id":"proverbs-d42eda89","p":400,"t":"text","q":"كمّل المثل: \"يا ماخذ القرد على ماله ...\"","a":"يروح المال ويبقى القرد على حاله"},{"id":"proverbs-c8303219","p":400,"t":"text","q":"كمّل المثل: \"الدنيا دولاب ...\"","a":"يوم إلك ويوم عليك"},{"id":"proverbs-16778fbd","p":400,"t":"text","q":"كمّل المثل: \"خلّي العسل بجراره ...\"","a":"لما تجي أسعاره"},{"id":"proverbs-737eb6c0","p":400,"t":"text","q":"كمّل المثل: \"شين ...\"","a":"وقوي عين"},{"id":"proverbs-fc3b80b6","p":400,"t":"text","q":"كمّل المثل: \"اللي استحوا ...\"","a":"ماتوا"},{"id":"proverbs-ac4de549","p":400,"t":"text","q":"كمّل المثل: \"من دهنه ...\"","a":"سگّيله"},{"id":"proverbs-a39162dc","p":400,"t":"text","q":"كمّل المثل: \"يا رايح ...\"","a":"كثّر الفضايح"},{"id":"proverbs-8e54fbbf","p":400,"t":"text","q":"كمّل المثل: \"المكتوب على الجبين ...\"","a":"لازم تشوفه العين"},{"id":"proverbs-5a16e96d","p":600,"t":"text","q":"كمّل المثل: \"اللي يدري يدري، واللي ما يدري ...\"","a":"گضبة عدس"},{"id":"proverbs-a12289be","p":600,"t":"text","q":"كمّل المثل: \"اللي ما يعرف تدابيره ...\"","a":"حنطته تاكل شعيره"},{"id":"proverbs-3f25f13d","p":600,"t":"text","q":"كمّل المثل: \"حچي الليل مدهون بزبدة ...\"","a":"تطلع عليه الشمس يذوب"},{"id":"proverbs-c6027f19","p":600,"t":"text","q":"كمّل المثل: \"تريد أرنب أخذ أرنب ...\"","a":"تريد غزال أخذ أرنب"},{"id":"proverbs-9e1304f8","p":600,"t":"text","q":"كمّل المثل: \"يا حافر البير ...\"","a":"لا تغمّج مساحيها"},{"id":"proverbs-fa01bcdb","p":600,"t":"text","q":"شنو معنى المثل \"مثل اللي يودّي تمر للبصرة\"؟","a":"ينطي شي لناس عدهم منه هواية"},{"id":"proverbs-dff01f9c","p":600,"t":"text","q":"شنو معنى المثل \"الگرد بعين أمه غزال\"؟","a":"كل واحد يشوف ابنه أو شغله حلو حتى لو مو حلو"},{"id":"proverbs-61261c4d","p":600,"t":"text","q":"شنو معنى المثل \"عرب وين طنبورة وين\"؟","a":"كلام ما إله علاقة بالموضوع"},{"id":"proverbs-588fc3e2","p":600,"t":"text","q":"شنو معنى المثل \"اللي ما يعرف الصگر يشويه\"؟","a":"اللي ما يعرف قيمة الشي يضيّعه"},{"id":"proverbs-74155077","p":600,"t":"text","q":"شنو معنى المثل \"أول الرقص حنجلة\"؟","a":"كل شي كبير يبدي بخطوة صغيرة"},{"id":"proverbs-78386a26","p":600,"t":"text","q":"كمّل المثل: \"الحچي إلچ يا چنّة ...\"","a":"واسمعي يا جارة"},{"id":"proverbs-8303bd7c","p":600,"t":"text","q":"شنو معنى \"بعد خراب البصرة\"؟","a":"الحل أو المساعدة وصلت متأخرة"},{"id":"proverbs-7eee2161","p":600,"t":"text","q":"شنو معنى المثل \"على حس الطبل خفّن يا رجليّه\"؟","a":"يتحمس ويركض ورا أي شي بدون تفكير"},{"id":"proverbs-c002590e","p":600,"t":"text","q":"شنو معنى \"مثل الأطرش بالزفة\"؟","a":"موجود بس ما فاهم شي من الي يصير"},{"id":"proverbs-a50c2ffd","p":600,"t":"text","q":"شنو معنى \"شين وقوي عين\"؟","a":"غلطان ووقح وما يستحي"},{"id":"proverbs-971f7578","p":600,"t":"text","q":"شنو معنى المثل \"الباب اللي تجيك منه الريح سدّه واستريح\"؟","a":"ابتعد عن مصدر المشاكل"},{"id":"proverbs-1db71678","p":600,"t":"text","q":"شنو معنى المثل \"من دهنه سگّيله\"؟","a":"ينطيه من نفس ماله أو من نفس الشي"},{"id":"proverbs-10d7ba41","p":600,"t":"text","q":"شنو معنى المثل \"حب واحچي واكره واحچي\"؟","a":"الكلام عن الشخص يتغير حسب محبتك إله"},{"id":"proverbs-670e1c99","p":600,"t":"text","q":"كمّل المثل: \"اللي ما عنده چبير ...\"","a":"يشتريله چبير"},{"id":"proverbs-0ab60188","p":600,"t":"text","q":"شنو معنى المثل \"إذا ردت تحيّره خيّره\"؟","a":"كثرة الخيارات تحيّر الإنسان"}]}